{
  "protocol_id": "metabears-halfmnist-v1",
  "frozen_core_commit": "b50a63fa584936686623027befae8c7c76e257be",
  "dataset": {
    "name": "halfmnist",
    "task": "addition",
    "model": "mnistdpl",
